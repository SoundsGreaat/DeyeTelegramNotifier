INVERTER_IP=1.1.1.1
LOGGER_SERIAL=2222222222

TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

CHECK_INTERVAL=10
LOG_LEVEL=INFO

# PostgreSQL settings for standalone runs and the Alembic CLI.
# Bundled Compose retains its original connection settings for both services.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=deye_bot

# Apply Alembic revisions before starting the bot. false = verify schema only.
DB_AUTO_MIGRATE=true
# Timezone of old naive monitor timestamps, before the first versioned upgrade.
# Keep UTC for the original Docker setup; use the old host zone otherwise.
LEGACY_DB_TIMEZONE=UTC

# Fallback runtime estimate. Set the TOTAL nominal battery capacity in kWh.
# 0 disables the fallback; measured current/capacity estimates still work.
BATTERY_CAPACITY_KWH=0
# Fallback when inverter shutdown SOC is unavailable; does not change it.
BATTERY_CUTOFF_SOC=20
# Estimated conversion efficiency (0.01..1).
BATTERY_INVERTER_EFFICIENCY=0.90

# Calendar periods and automatic reports (day / Monday-based week / month).
STATS_TIMEZONE=Europe/Kyiv
# Local hour (0..23) after the period ends; opt in with /stats_auto_on.
STATS_REPORT_HOUR=9
# Global availability; each chat still needs its own explicit subscription.
STATS_AUTO_REPORTS=true

# Optional schedule forecast. Leave SCHEDULE_PROVIDER empty to disable it.
# The application remains usable worldwide without these settings.
SCHEDULE_PROVIDER=
SCHEDULE_REGION_ID=
SCHEDULE_DSO_ID=
SCHEDULE_CITY_ID=
SCHEDULE_STREET=
SCHEDULE_HOUSE=
SCHEDULE_TIMEZONE=UTC
SCHEDULE_REFRESH_INTERVAL=600
SCHEDULE_REQUEST_TIMEOUT=4
